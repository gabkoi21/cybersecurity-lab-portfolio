# SSH Log Analysis using Splunk - Investigation Searches

# Validate SSH event categories.
index=ssh_logs source="ssh_logs.json"
| stats count by event_type

# Analyze failed SSH login attempts by source IP.
index=ssh_logs source="ssh_logs.json" event_type="Failed SSH Login"
| stats count by id.orig_h
| head 10

# Detect multiple failed authentication attempts by source and destination.
index=ssh_logs source="ssh_logs.json" event_type="Multiple Failed Authentication Attempts"
| stats count by id.orig_h id.resp_h

# Track successful SSH logins by source and destination.
index=ssh_logs source="ssh_logs.json" event_type="Successful SSH Login"
| stats count by id.orig_h id.resp_h

# Identify connections without authentication by source IP.
index=ssh_logs event_type="Connection Without Authentication"
| stats count by id.orig_h

# Visualize unauthenticated SSH connections over time.
index=ssh_logs event_type="Connection Without Authentication"
| timechart count by id.orig_h

# Example brute-force alert logic.
index=ssh_logs event_type="Multiple Failed Authentication Attempts"
| stats count by id.orig_h id.resp_h
| where count > 5
